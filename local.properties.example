# Copy this file to `local.properties` and fill in real values.
# `local.properties` is gitignored — secrets never enter the repo.

# Android SDK location (Android Studio fills this in automatically on first open).
#sdk.dir=/home/you/Android/Sdk

# Release signing (see keystore/ — generated once with keytool, never committed).
# Debug builds do NOT need any of this; only assembleRelease uses it.
#signing.storeFile=keystore/kauth.jks
#signing.storePassword=changeit
#signing.keyAlias=kauth
#signing.keyPassword=changeit
