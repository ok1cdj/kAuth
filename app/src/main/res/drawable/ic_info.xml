<?xml version="1.0" encoding="utf-8"?>
<!-- Solid info badge: black filled circle with a white "i". Rendered via Image
     (no tint) so the white shows. Circle drawn as two semicircle arcs — a single
     360° arc is unreliable across renderers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#000000"
        android:pathData="M2,12 a10,10 0 1 0 20,0 a10,10 0 1 0 -20,0 Z" />
    <!-- white 'i' dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.4,6 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0 Z" />
    <!-- white 'i' stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.6,10 h2.8 v8 h-2.8 z" />
</vector>
