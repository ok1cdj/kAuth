<?xml version="1.0" encoding="utf-8"?>
<!-- kAuth launcher foreground: a black padlock with a white keyhole. Centered on
     the 108x108 canvas (both axes about 54,54) and kept inside the 72dp adaptive
     safe zone so no launcher mask crops or offsets it. Reused as the in-app mark
     on the unlock screen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shackle -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M45,52 L45,45 a9,9 0 0 1 18,0 L63,52" />

    <!-- lock body -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M43,52 L65,52 a4,4 0 0 1 4,4 L69,72 a4,4 0 0 1 -4,4 L43,76 a4,4 0 0 1 -4,-4 L39,56 a4,4 0 0 1 4,-4 Z" />

    <!-- white keyhole: dot + stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,62 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.6,64 h2.8 l0.9,8 h-4.6 z" />
</vector>
