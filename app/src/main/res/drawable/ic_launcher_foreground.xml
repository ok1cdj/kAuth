<?xml version="1.0" encoding="utf-8"?>
<!-- kAuth launcher foreground: a black padlock with a white keyhole on the white
     adaptive background — the vault/2FA motif. Deliberately small within the
     108dp adaptive safe zone (lots of breathing room). Reused as the in-app
     header mark on the unlock screen, so both stay identical. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shackle -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M45,56 L45,50 a9,9 0 0 1 18,0 L63,56" />

    <!-- lock body -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M43,56 L65,56 a4,4 0 0 1 4,4 L69,78 a4,4 0 0 1 -4,4 L43,82 a4,4 0 0 1 -4,-4 L39,60 a4,4 0 0 1 4,-4 Z" />

    <!-- white keyhole: dot + stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,66 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.6,68 h2.8 l0.9,8 h-4.6 z" />
</vector>
